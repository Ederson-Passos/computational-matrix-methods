      "source": [
        "import numpy as np\n",
        "\n",
        "x = np.array([1, 0, -1, 2])\n",
        "\n",
        "norma1 = np.linalg.norm(x, 1)\n",
        "norma2 = np.linalg.norm(x,2)          # ou ord=2\n",
        "norma_inf = np.linalg.norm(x, np.inf)\n",
        "\n",
        "print(\"Norma 1  =\", norma1)\n",
        "print(\"Norma 2  =\", norma2)\n",
        "print(\"Norma inf=\", norma_inf)\n"
      ]
    }
